# Runix Terminal Platform - Environment Configuration

# Client-Side Firebase Configuration (Required for Web Authentication & Client State)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-Side Firebase Admin Configuration (For Privileged Backend Verification & Account Operations)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternatively, supply the full single-line JSON string:
# FIREBASE_SERVICE_ACCOUNT_KEY=

# Execution Runner & Sandbox Limits
MAX_EXECUTION_TIMEOUT_MS=30000
MAX_BUFFER_OUTPUT_BYTES=5242880
RUNIX_DEFAULT_SHELL=bash

# Super Admin Master Access Key (Restricted to owner)
SUPER_ADMIN_KEY=runix-superadmin-master-2026

